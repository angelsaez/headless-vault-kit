# headless-vault-kit — deployment configuration
#
# Copy to ~/.config/hvk/deploy.env and edit. Every systemd unit and script reads this file
# and nothing else, so paths appear once (ADR-0006).
#
# This file holds paths, not secrets. Tokens belong in their own files with mode 600 — see
# TELEGRAM_ENV below.

# --- required ------------------------------------------------------------------------------

# The vault to sync, index and check point. No trailing slash.
HVK_VAULT="$HOME/vault"

# Absolute paths to the three runtimes. `command -v hvk` and friends will tell you.
# They are absolute on purpose: a systemd unit does not inherit your interactive PATH, so
# "hvk" alone works in your shell and fails at boot.
HVK_BIN="$HOME/.local/bin/hvk"
OB_BIN="$HOME/.local/bin/ob"
CLAUDE_BIN="$HOME/.local/bin/claude"

# --- optional ------------------------------------------------------------------------------

# Where the index lives. Leave unset for the default of ADR-0002:
# ${XDG_DATA_HOME:-~/.local/share}/hvk/<vault>-<hash8>/
#HVK_INDEX_DIR=""

# The vault name as Obsidian Sync knows it. Only needed if it differs from the folder name.
#OB_VAULT_NAME="My Vault"

# tmux session holding the interactive Claude Code session. `tmux attach -t $TMUX_SESSION`
# gets you in.
TMUX_SESSION="hvk-agent"

# The Telegram channel plugin, and the file holding its token. The plugin writes the token
# here itself when you run /telegram:configure. Keep it mode 600; it is a bot credential.
CLAUDE_CHANNELS="plugin:telegram@claude-plugins-official"
TELEGRAM_ENV="$HOME/.claude/channels/telegram/.env"

# How long the watcher waits for a file to stop changing before indexing it. Obsidian Headless
# writes large files in several steps, and the default is usually right.
#HVK_WATCH_DEBOUNCE="1.0"

# Git checkpoints inside the vault. Local only, no remote (ADR-0006, plan annex decision 5).
# Set to 0 to skip the auto-commit entirely.
AUTOCOMMIT_ENABLED=1
AUTOCOMMIT_MESSAGE="checkpoint"
