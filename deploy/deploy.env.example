# headless-vault-kit — deployment configuration
#
# Copy to ~/.config/hvk/deploy.env and edit. Every systemd unit and script reads this file
# and nothing else, so paths appear once (ADR-0006).
#
# This file holds paths, not secrets. Tokens belong in their own files with mode 600 — see
# TELEGRAM_ENV below.
#
# EVERY PATH HERE MUST BE ABSOLUTE AND LITERAL. systemd reads this file itself and does not
# run a shell over it, so "$HOME/vault" arrives at the service as those eleven characters and
# the unit dies with status 127 and "not found" — naming a path that looks perfectly correct
# in your terminal, where the shell would have expanded it. `echo $HOME` gives you the value
# to paste. The same goes for ~, $USER and $(command -v hvk).

# --- required ------------------------------------------------------------------------------

# The vault to sync, index and check point. No trailing slash. Absolute: see the note above.
HVK_VAULT="/home/CHANGE-ME/vault"

# Absolute paths to the three runtimes. `command -v hvk` and friends will tell you.
# They are absolute on purpose: a systemd unit does not inherit your interactive PATH, so
# "hvk" alone works in your shell and fails at boot.
HVK_BIN="/home/CHANGE-ME/.local/bin/hvk"
OB_BIN="/home/CHANGE-ME/.local/bin/ob"
CLAUDE_BIN="/home/CHANGE-ME/.local/bin/claude"

# --- optional ------------------------------------------------------------------------------

# Where the index lives. Leave unset for the default of ADR-0002:
# ${XDG_DATA_HOME:-~/.local/share}/hvk/<vault>-<hash8>/
#HVK_INDEX_DIR=""

# The vault name as Obsidian Sync knows it. Only needed if it differs from the folder name.
#OB_VAULT_NAME="My Vault"

# tmux session holding the interactive Claude Code session. `tmux attach -t $TMUX_SESSION`
# gets you in.
TMUX_SESSION="hvk-agent"

# The Telegram channel plugin, and the file holding its token. The plugin writes the token
# here itself when you run /telegram:configure. Keep it mode 600; it is a bot credential.
CLAUDE_CHANNELS="plugin:telegram@claude-plugins-official"
TELEGRAM_ENV="/home/CHANGE-ME/.claude/channels/telegram/.env"

# How long the watcher waits for a file to stop changing before indexing it. Obsidian Headless
# writes large files in several steps, and the default is usually right.
#HVK_WATCH_DEBOUNCE="1.0"

# --- materialised views (phase 4) -----------------------------------------------------------

# Regenerate the base tables materialised inside notes. Safe to run often: it writes only what
# changed and nothing at all when nothing did, so it never wakes sync for no reason. Set to 0
# to stop refreshing them.
VIEWS_ENABLED=1
VIEWS_EVERY_MINUTES=30

# --- order-notes (phase 5) ------------------------------------------------------------------

# The runner is scheduled every minute but does nothing until BOTH of these are set. There is
# no default on purpose (ADR-0009): a runner that starts executing an agent because a folder
# happened to have the right name is the failure the feature exists to prevent. Setting them
# here is what turns the runner on -- no reinstall needed.
#
# HVK_JOBS_DIR is relative to the vault. HVK_JOBS_PROFILES must be OUTSIDE the vault: a
# profile says what an agent is allowed to do, and one that syncs is a permission grant your
# phone could edit.
HVK_JOBS_DIR=""
HVK_JOBS_PROFILES=""

# Git checkpoints inside the vault. Local only, no remote (ADR-0006, plan annex decision 5).
# Set to 0 to skip the auto-commit entirely.
AUTOCOMMIT_ENABLED=1
AUTOCOMMIT_MESSAGE="checkpoint"

# --- backup off the machine (phase 6) -------------------------------------------------------

# Where the daily archive of the vault is written. Setting it is what schedules the backup:
# empty, and no cron entry is written at all (ADR-0013). Must be OUTSIDE the vault -- inside,
# it would sync, be indexed, and tomorrow's copy would contain today's.
#
# The archive holds everything the vault holds, private folders included, so treat wherever it
# ends up as being as sensitive as the vault itself.
BACKUP_DIR=""

# How many archives to keep here. The local ones are the convenience; the copy off the machine
# is the backup.
#BACKUP_KEEP=7

# When it runs. Five cron fields.
#BACKUP_CRON="41 3 * * *"

# What takes the archive off this machine, which is the only part that survives losing it. An
# executable that receives two arguments: the archive and its .sha256. Yours to write, because
# only you know whether that means rclone, scp, or something with a tape in it:
#
#   #!/bin/sh
#   set -eu
#   rclone copy "$1" "remote:Backups/$(hostname)/vault/"
#   rclone copy "$2" "remote:Backups/$(hostname)/vault/"
#   # and then check it is really there -- an exit code is not a file:
#   rclone lsf "remote:Backups/$(hostname)/vault/" | grep -qx "$(basename "$1")"
#
#BACKUP_OFFSITE_HOOK=""

# Extra tar patterns to leave out, space separated. Obsidian's UI state and recovery snapshots
# and half-written files are already excluded; this is for a folder of video nobody needs a
# second copy of.
#BACKUP_EXCLUDE="./Attachments/video/*"
